rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null && request.auth.token != null;
    }

    function getUserUid() {
      return request.auth.uid;
    }

    function getUserEmail() {
      return request.auth.token.email != null ? request.auth.token.email.lower() : '';
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isMe(identifier) {
      return isAuthenticated() && identifier != null &&
             (getUserUid() == identifier || getUserEmail() == string(identifier).lower());
    }

    function hasNoPrivateKey() {
      return !request.resource.data.keys().hasAny(['privateKey']);
    }

    function isValidUser(data) {
      return data.uid is string;
    }

    // NOTE: deliberately no `participants is list` type guard here. That guard
    // makes the rule unsatisfiable for LIST queries, because Firestore cannot
    // prove a query constraint implies a type check on resource.data, and the
    // chat list then fails with permission-denied. Verified against the
    // Firestore emulator: with the guard, array-contains queries are denied.
    // A non-list `participants` simply makes the `in` test error, which denies.
    function isConversationParticipant(participants) {
      return getUserUid() in participants
        || (getUserEmail() != '' && getUserEmail() in participants);
    }

    function conversationDoc(chatId) {
      return get(/databases/$(database)/documents/conversations/$(chatId));
    }

    function isMemberOfChat(chatId) {
      return isAuthenticated()
        && isConversationParticipant(conversationDoc(chatId).data.participants);
    }

    // Selective-recipient (private) messages are stored one level away from the
    // shared message log, in `private_messages`. Access is scoped to the exact
    // recipient UIDs recorded on the message, so a group member who was not
    // selected cannot read the document even if they know its ID. The client
    // always queries the collection with
    // `where('visibleTo', 'array-contains', uid)`, which is what makes this rule
    // satisfiable for list queries.
    function canReadPrivateMessage(chatId) {
      return isMemberOfChat(chatId)
        && request.auth.uid in resource.data.visibleTo;
    }

    // Private user profiles — private keys must never be stored server-side.
    // Public profile data (displayName, photoURL, publicKey, presence) lives in
    // /users_public, so a private profile is only ever read by its own owner.
    match /users/{userId} {
      allow read: if isMe(userId) || isAdmin();
      allow create: if isMe(userId) && hasNoPrivateKey();
      allow update: if isMe(userId) && hasNoPrivateKey();
      allow delete: if isMe(userId) || isAdmin();

      // Contact lists.
      // Reads stay open to signed-in users: reciprocal discovery checks whether
      // another user has already added you, which requires reading their list.
      // Writes are limited to the list owner, or to a user adding *themselves*
      // to someone else's list (the reciprocal_auto write). That self-add is
      // accepted only when both the document id and the stored uid equal the
      // writer's uid, so nobody can plant, rename or delete contacts they do
      // not own.
      match /contacts/{contactId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated()
          && (isMe(userId)
              || (contactId == getUserUid() && request.resource.data.uid == getUserUid()));
        allow delete: if isMe(userId) || isAdmin();
      }
    }

    // Public profile directory — readable by any signed-in user so that user
    // search, presence and public-key lookup keep working, but a profile can
    // only be written by its owner (or an admin). This blocks public-key
    // substitution and account-status tampering by other users.
    match /users_public/{userId} {
      allow read: if isAuthenticated();
      allow create: if isMe(userId) || isAdmin();
      allow update: if isMe(userId) || isAdmin();
      allow delete: if isMe(userId) || isAdmin();
    }

    match /conversations/{chatId} {
      // Only participants may read or modify a conversation. The client always
      // queries with where('participants', 'array-contains', ...), so these
      // rules stay satisfiable for list queries.
      //
      // A `get` on a conversation that does not exist yet must also be allowed:
      // starting a brand-new chat first probes the document to see whether it
      // was previously deleted. Denying that probe makes `getDoc` throw
      // permission-denied instead of returning "not found", so the client never
      // reaches the create call and adding a contact appears to do nothing.
      // There is no data to protect when the document does not exist.
      allow get: if !exists(/databases/$(database)/documents/conversations/$(chatId))
        || isConversationParticipant(resource.data.participants);
      allow list: if isConversationParticipant(resource.data.participants);
      allow create: if isAuthenticated()
        && request.resource.data.participants is list
        && isConversationParticipant(request.resource.data.participants);
      allow update: if isConversationParticipant(resource.data.participants);
      allow delete: if isConversationParticipant(resource.data.participants);

      match /messages/{messageId} {
        // Only members of the parent conversation may read or modify messages.
        allow read: if isMemberOfChat(chatId);

        allow create: if isMemberOfChat(chatId)
          && (getUserUid() == request.resource.data.senderId
              || request.resource.data.senderId == 'aegis-guard@aegis.ai');

        allow update: if isMemberOfChat(chatId);
        allow delete: if isMemberOfChat(chatId);
      }

      // Selective-recipient messages inside the same group conversation.
      // `visibleTo` lists the UIDs that may ever read the document; the sender
      // is always included. Non-selected members cannot read, list, update or
      // delete these messages, so the restriction is enforced by the database
      // and not just by the UI.
      match /private_messages/{messageId} {
        allow read: if canReadPrivateMessage(chatId);

        allow create: if isMemberOfChat(chatId)
          && request.resource.data.visibleTo is list
          && getUserUid() == request.resource.data.senderId
          && getUserUid() in request.resource.data.visibleTo;

        // Recipients may update read/reaction state, but they can never widen
        // the audience or change who sent the message.
        allow update: if canReadPrivateMessage(chatId)
          && request.resource.data.visibleTo == resource.data.visibleTo
          && request.resource.data.senderId == resource.data.senderId;
        allow delete: if canReadPrivateMessage(chatId);
      }
    }

    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }

    match /scheduled_events/{eventId} {
      allow read: if isAuthenticated()
        && (getUserUid() in resource.data.participants || isAdmin());
      allow create: if isAuthenticated()
        && request.resource.data.creatorId == getUserUid();
      allow update, delete: if isAuthenticated()
        && (getUserUid() in resource.data.participants
            || resource.data.creatorId == getUserUid()
            || isAdmin());
    }

    match /status_updates/{statusId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated()
        && (resource.data.userId == getUserUid() || !("userId" in resource.data));
      allow delete: if isAuthenticated()
        && (resource.data.userId == getUserUid() || isAdmin());
    }

    match /security_audit_logs/{logId} {
      allow create: if isAuthenticated() && request.resource.data.userId == getUserUid();
      allow read: if isAuthenticated() && (resource.data.userId == getUserUid() || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /devices/{deviceId} {
      allow create: if isAuthenticated() && request.resource.data.userId == getUserUid();
      allow read: if isAuthenticated() && (resource.data.userId == getUserUid() || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.userId == getUserUid() || isAdmin());
    }

    match /user_sessions/{sessionId} {
      allow create: if isAuthenticated() && request.resource.data.userId == getUserUid();
      allow read: if isAuthenticated() && (resource.data.userId == getUserUid() || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.userId == getUserUid() || isAdmin());
    }

    match /threat_intelligence/{reportId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == getUserUid() || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == getUserUid();
      allow update: if isAuthenticated()
        && (resource.data.userId == getUserUid() || isAdmin());
    }

    match /meeting_rooms/{roomId} {
      allow read: if isAuthenticated()
        && (getUserUid() in resource.data.participants || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated()
        && (getUserUid() in resource.data.participants
            || request.resource.data.hostId == getUserUid()
            || isAdmin());
      allow delete: if isAuthenticated()
        && (resource.data.hostId == getUserUid() || isAdmin());
    }

    match /call_sessions/{callId} {
      allow read: if isAuthenticated()
        && (resource.data.callerId == getUserUid()
            || resource.data.calleeId == getUserUid()
            || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated()
        && (resource.data.callerId == getUserUid()
            || resource.data.calleeId == getUserUid()
            || isAdmin());
    }

    match /moderation_actions/{actionId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    match /platform_analytics/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
