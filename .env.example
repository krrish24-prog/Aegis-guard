NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODEL=google/diffusiongemma-26b-a4b-it
# Used only when a request contains an image. Leave unset for the default vision model.
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
AI_MAX_TOKENS=650
NODE_ENV=production
# Backblaze B2 media storage (S3-compatible).
# Create a private bucket and an application key that can read/write only that bucket.
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=aegis-guard-media
B2_REGION=us-west-004
# Optional; defaults to https://s3.<B2_REGION>.backblazeb2.com
# B2_ENDPOINT=

# Legacy Appwrite storage (optional). Only needed if you still have files uploaded
# through the old Appwrite path and want their /api/storage/files links to keep working.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_appwrite_project_id
APPWRITE_API_KEY=your_appwrite_api_key
APPWRITE_BUCKET_ID=aegis-media
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_IMPERSONATE=
